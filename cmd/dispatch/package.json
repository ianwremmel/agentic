{
  "name": "@agentic/dispatch",
  "version": "0.0.1",
  "private": true,
  "description": "Dispatch CLI and daemon (see docs/spec/03-cli/).",
  "type": "module",
  "bin": {
    "dispatch": "./dist/dispatch.cjs"
  },
  "scripts": {
    "dev": "node src/index.mts",
    "build": "esbuild src/index.mts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/dispatch.cjs --legal-comments=none",
    "typecheck": "tsc --noEmit",
    "sea": "npm run build && node scripts/build-sea.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
