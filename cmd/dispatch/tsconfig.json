{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "declaration": false,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "lib": ["ES2023"],
    "module": "Node20",
    "moduleResolution": "node16",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
