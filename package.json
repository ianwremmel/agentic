{
  "name": "@ianwremmel/dispatch",
  "version": "0.0.0",
  "private": true,
  "description": "dispatch CLI — orchestrates engineering work across PRs and trackers",
  "license": "MIT",
  "author": "Ian Remmel",
  "type": "module",
  "bin": {
    "dispatch": "dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node scripts/sea.mjs",
    "build": "npm run typecheck && npm run bundle && npm run sea",
    "build:host": "npm run typecheck && npm run bundle && node scripts/sea.mjs --host-only",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run bundle && node --test --experimental-strip-types 'src/**/*.test.mts'",
    "test:wrapper": "sh plugins/dispatch/tests/dispatch.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.6.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
