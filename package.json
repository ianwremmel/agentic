{
  "name": "@ianwremmel/agentic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Claude Code plugin marketplace of agentic workflows for everyday software engineering.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "eslint --fix --no-warn-ignored",
    "prepare": "husky",
    "test": "node --test \"plugins/**/*.test.mts\" \"scripts/**/*.test.mts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "yaml-eslint-parser": "^2.1.0"
  },
  "lint-staged": {
    "*.{mts,mjs,md,json,yml,yaml}": "npm run lint:staged --"
  }
}
