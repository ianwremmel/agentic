#!/usr/bin/env node
// dispatch-state — the run's compute-slot ledger, liveness locks, active set, and
// injection queue. The implementation lives in ../lib/state; this is the entry
// point on PATH.

import {main} from '../lib/state/cli.mts';

try {
  main(process.argv.slice(2));
} catch (error) {
  console.error(`dispatch-state: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(2);
}
