#!/usr/bin/env python3
"""derive — the tracker-neutral graph engine for §2.6 orchestration.

It does ALL graph *reasoning* a §2.6 producer must perform, so a per-tracker
adapter only has to *fetch and normalize* (the one tracker-specific step). Given

  - the durable normalized graph cache (accumulated nodes/milestones/projects),
    or nothing on first run, and
  - a normalized `sync` or `delta` emitted by an adapter (schema
    `dispatch/normalized-graph@1`; see ../schema/normalized-graph.schema.json),

derive merges the input into the cache and emits the **project-graph document**
(schema `dispatch/project-graph@1`) the orchestrator reads: node tags plus the
derived sections `available` / `blocked` / `human-blocked` /
`permanently-blocked` / `milestones` / `counts` / `anomalies`.

Reasoning implemented here (none of it belongs in an adapter):
  * effective-blocking per §2.3 (a canceled ancestor UNBLOCKS; verified/canceled
    are the only "resolved" roles);
  * milestone-review gating expressed AS effective-blocking (a ticket in a later
    milestone is blocked until every earlier milestone in its project is both
    ready-for-review AND review-recorded);
  * stale-review suppression guard: an incomplete milestone is forced
    not-ready-for-review, and a not-ready milestone is forced not-review-recorded,
    so §2.3's re-review is never suppressed by a stale record;
  * permanent-block classification (a transitive ancestor terminated without
    `verified` and is not `canceled`);
  * ranking of the available frontier (milestone order, then unblocking leverage,
    then id) with injected ids forced to the head;
  * exclusion of in-flight / done / failed ids from the scheduling sections only
    (node/edge state is still merged and emitted);
  * cycle and cross-project-edge anomaly detection.

Writes are atomic (write-temp-then-rename). The merged durable graph is written
back to --state; the document goes to --doc (or stdout).

Usage:
  derive --state <cache.json> --input <adapter-output.json>
         [--doc <out.json>] [--exclude id,id,...] [--top id,id,...]

Dependencies: python3 (stdlib only).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile

SCHEMA_GRAPH = "dispatch/normalized-graph@1"
SCHEMA_DOC = "dispatch/project-graph@1"

RESOLVED_ROLES = {"verified", "canceled"}   # §2.3: only these clear a dependency
PARKED_ROLES = {"awaiting-external", "paused"}
STARTABLE_ROLE = "available"                # §2.3 role meaning "ready to pick up"
SCHEDULABLE_KINDS = {"pr", "verification"}  # human-only is never dispatched


def die(msg: str) -> None:
    sys.stderr.write(f"derive: {msg}\n")
    sys.exit(2)


def load_json(path: str):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        die(f"cannot read {path}: {exc}")


def atomic_write(path: str, obj) -> None:
    d = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".derive-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


# ---------------------------------------------------------------- merge --------

def empty_graph() -> dict:
    return {"schema": SCHEMA_GRAPH, "kind": "cache", "source": None,
            "cursor": None, "projects": {}, "milestones": {}, "nodes": {}}


def index(items, key="id") -> dict:
    return {it[key]: it for it in (items or []) if it.get(key) is not None}


def merge(cache: dict, incoming: dict) -> dict:
    """Deterministic mechanical merge. `sync` replaces; `delta` upserts + removes.
    No graph reasoning happens here — that is the whole point of the split."""
    kind = incoming.get("kind")
    if kind not in ("sync", "delta"):
        die(f"input kind must be 'sync' or 'delta', got {kind!r}")

    if kind == "sync":
        cache = empty_graph()

    cache["source"] = incoming.get("source", cache.get("source"))
    cache["cursor"] = incoming.get("cursor", cache.get("cursor"))

    for coll in ("projects", "milestones", "nodes"):
        cur = cache.setdefault(coll, {})
        for ident, item in index(incoming.get(coll)).items():
            cur[ident] = item

    for ident in incoming.get("removed", []) or []:
        cache["nodes"].pop(ident, None)
        cache["milestones"].pop(ident, None)
        cache["projects"].pop(ident, None)

    cache["schema"] = SCHEMA_GRAPH
    cache["kind"] = "cache"
    return cache


# ------------------------------------------------------------- reasoning -------

def milestone_gate(cache: dict) -> dict:
    """Return {milestone_id: gate_open_bool}. A milestone's gate is OPEN (does not
    block later milestones) once it is complete, ready-for-review and
    review-recorded. Also applies the stale-review guard in place on the cache's
    milestone records so the emitted `milestones` section is honest."""
    nodes = cache["nodes"].values()
    # per-milestone completeness: every ticket in it is verified/canceled/perm-dead
    complete = {}
    for mid, m in cache["milestones"].items():
        members = [n for n in nodes if n.get("milestone") == mid]
        complete[mid] = all(
            n.get("role") in RESOLVED_ROLES or n.get("terminated_without_verify")
            for n in members
        ) if members else True

    gate_open = {}
    for mid, m in cache["milestones"].items():
        rfr = bool(m.get("ready_for_review"))
        rec = bool(m.get("review_recorded"))
        # stale-review guard (§2.6): incomplete -> not ready; not ready -> not recorded
        if not complete.get(mid, True):
            rfr = False
        if not rfr:
            rec = False
        m["ready_for_review"] = rfr        # write the guarded values back
        m["review_recorded"] = rec
        m["complete"] = complete.get(mid, True)
        gate_open[mid] = rfr and rec
    return gate_open


def milestone_blocked(node: dict, cache: dict, gate_open: dict) -> bool:
    """A node is milestone-gated if any EARLIER milestone in its project has not
    passed its review gate (§2.3 sequencing, expressed as effective-blocking)."""
    mid = node.get("milestone")
    if mid is None:
        return False
    me = cache["milestones"].get(mid)
    if me is None:
        return False
    my_order, my_proj = me.get("order", 0), me.get("project")
    for other_id, other in cache["milestones"].items():
        if other_id == mid or other.get("project") != my_proj:
            continue
        if other.get("order", 0) < my_order and not gate_open.get(other_id, False):
            return True
    return False


def compute(cache: dict, exclude: set, top: list) -> dict:
    nodes = cache["nodes"]
    gate_open = milestone_gate(cache)

    def resolved(nid: str) -> bool:
        n = nodes.get(nid)
        return n is not None and n.get("role") in RESOLVED_ROLES

    def dep_blocked(nid: str) -> bool:
        # blocked iff any DIRECT blocker is not resolved (verified/canceled).
        # Transitivity is unnecessary for the boolean: an unresolved blocker is
        # itself blocked-or-in-flight, which already blocks us.
        return any(not resolved(b) for b in nodes[nid].get("blocked_by", []))

    # permanent-block: a transitive blocker is dead (terminated w/o verify, not
    # canceled). Memoized; cycle-safe via an in-progress guard.
    perm_memo: dict = {}

    def perm_blocked(nid: str, stack: set) -> bool:
        if nid in perm_memo:
            return perm_memo[nid]
        if nid in stack:               # cycle — don't recurse forever
            return False
        stack.add(nid)
        result = False
        for b in nodes[nid].get("blocked_by", []):
            bn = nodes.get(b)
            if bn is None:
                continue
            dead = bool(bn.get("terminated_without_verify")) and \
                bn.get("role") not in RESOLVED_ROLES
            if dead or perm_blocked(b, stack):
                result = True
                break
        stack.discard(nid)
        perm_memo[nid] = result
        return result

    def is_blocked(nid: str) -> bool:
        return dep_blocked(nid) or milestone_blocked(nodes[nid], cache, gate_open)

    # transitive-dependent count = unblocking leverage (for ranking): how many
    # nodes (transitively) depend on a node — the reach it frees when it lands.
    # Reverse adjacency + reverse-reachability; cycle-safe via the visited set.
    rdeps: dict = {nid: [] for nid in nodes}
    for nid, n in nodes.items():
        for b in n.get("blocked_by", []):
            if b in rdeps:
                rdeps[b].append(nid)

    def leverage(nid: str) -> int:
        seen: set = set()
        stack = list(rdeps.get(nid, []))
        while stack:
            cur = stack.pop()
            if cur in seen:
                continue
            seen.add(cur)
            stack.extend(rdeps.get(cur, []))
        return len(seen)

    dependents: dict = {nid: leverage(nid) for nid in nodes}

    def human(n: dict) -> bool:
        return bool(n.get("human_interactive")) or n.get("role") in PARKED_ROLES

    available, blocked, human_blocked, perm = [], [], [], []
    for nid, n in nodes.items():
        pb = perm_blocked(nid, set())
        n_dead = bool(n.get("terminated_without_verify")) and \
            n.get("role") not in RESOLVED_ROLES
        # tag the node in place (orchestrator may read node tags too)
        n["blocked"] = is_blocked(nid)
        n["permanently_blocked"] = pb or n_dead

        if human(n):
            human_blocked.append(nid)
            continue
        if pb or n_dead:
            perm.append(nid)
            continue
        if n.get("role") in RESOLVED_ROLES:
            continue                                  # terminal; not scheduled
        if n.get("role") == STARTABLE_ROLE and \
                n.get("target_kind") in SCHEDULABLE_KINDS:
            if is_blocked(nid):
                blocked.append(nid)
            elif nid not in exclude:
                available.append(nid)
            # excluded-but-unblocked nodes fall through: still merged/emitted,
            # just absent from `available` (§2.6 exclusion rule).

    def rank_key(nid: str):
        n = nodes[nid]
        me = cache["milestones"].get(n.get("milestone") or "", {})
        return (me.get("order", 1 << 30), -dependents.get(nid, 0), nid)

    available.sort(key=rank_key)
    if top:
        head = [i for i in top if i in available]
        rest = [i for i in available if i not in set(head)]
        available = head + rest

    anomalies = detect_anomalies(nodes)
    counts = tally(cache)

    milestones = [
        {"id": mid, "project": m.get("project"), "order": m.get("order", 0),
         "ready_for_review": bool(m.get("ready_for_review")),
         "review_recorded": bool(m.get("review_recorded")),
         "complete": bool(m.get("complete"))}
        for mid, m in sorted(cache["milestones"].items(),
                             key=lambda kv: (kv[1].get("project") or "",
                                             kv[1].get("order", 0)))
    ]

    return {
        "schema": SCHEMA_DOC,
        "source": cache.get("source"),
        "cursor": cache.get("cursor"),
        "projects": sorted(cache["projects"].keys()),
        "nodes": [node_tag(nodes[nid]) for nid in sorted(nodes)],
        "available": available,
        "blocked": sorted(blocked),
        "human-blocked": sorted(human_blocked),
        "permanently-blocked": sorted(perm),
        "milestones": milestones,
        "counts": counts,
        "anomalies": anomalies,
    }


def node_tag(n: dict) -> dict:
    return {
        "id": n.get("id"), "url": n.get("url"), "project": n.get("project"),
        "milestone": n.get("milestone"), "role": n.get("role"),
        "group": n.get("group"), "target_kind": n.get("target_kind"),
        "human_interactive": bool(n.get("human_interactive")),
        "blocked": bool(n.get("blocked")),
        "permanently_blocked": bool(n.get("permanently_blocked")),
        "branch_seed": n.get("branch_seed"),
    }


def detect_anomalies(nodes: dict) -> list:
    anomalies = []
    # cycles via iterative DFS colouring
    WHITE, GREY, BLACK = 0, 1, 2
    colour = {nid: WHITE for nid in nodes}

    def visit(start: str):
        stack = [(start, iter(nodes[start].get("blocked_by", [])))]
        path = [start]
        colour[start] = GREY
        while stack:
            nid, it = stack[-1]
            advanced = False
            for nxt in it:
                if nxt not in nodes:
                    continue
                if colour[nxt] == GREY:            # back-edge => cycle
                    i = path.index(nxt) if nxt in path else 0
                    anomalies.append({"kind": "cycle",
                                      "nodes": path[i:] + [nxt]})
                elif colour[nxt] == WHITE:
                    colour[nxt] = GREY
                    path.append(nxt)
                    stack.append((nxt, iter(nodes[nxt].get("blocked_by", []))))
                    advanced = True
                    break
            if not advanced:
                colour[nid] = BLACK
                stack.pop()
                if path and path[-1] == nid:
                    path.pop()

    for nid in nodes:
        if colour[nid] == WHITE:
            visit(nid)

    # cross-project dependency edges (surfaced, not silently worked around)
    seen = set()
    for nid, n in nodes.items():
        for b in n.get("blocked_by", []):
            bn = nodes.get(b)
            if bn is None:
                continue
            if bn.get("project") and n.get("project") and \
                    bn.get("project") != n.get("project"):
                key = (b, nid)
                if key not in seen:
                    seen.add(key)
                    anomalies.append({"kind": "cross-project-edge",
                                      "from": b, "to": nid,
                                      "from_project": bn.get("project"),
                                      "to_project": n.get("project")})
    # de-dup cycles (same cycle can be found from several entries)
    uniq, keys = [], set()
    for a in anomalies:
        k = json.dumps(a, sort_keys=True) if a["kind"] != "cycle" else \
            "cycle:" + ",".join(sorted(set(a["nodes"])))
        if k not in keys:
            keys.add(k)
            uniq.append(a)
    return uniq


def tally(cache: dict) -> dict:
    per_project: dict = {}
    per_milestone: dict = {}
    for n in cache["nodes"].values():
        proj = n.get("project") or "_"
        pp = per_project.setdefault(proj, _zero())
        _bump(pp, n)
        mid = n.get("milestone")
        if mid is not None:
            _bump(per_milestone.setdefault(mid, _zero()), n)
    for tallies in (per_project, per_milestone):
        for t in tallies.values():
            t["terminal"] = t["verified"] + t["canceled"] + t["permanently_blocked"]
            t["remaining"] = t["total"] - t["terminal"]
    all_terminal = all(t["remaining"] == 0 for t in per_project.values())
    return {"projects": per_project, "milestones": per_milestone,
            "all_terminal": all_terminal}


def _zero() -> dict:
    return {"total": 0, "verified": 0, "canceled": 0, "permanently_blocked": 0}


def _bump(t: dict, n: dict) -> None:
    t["total"] += 1
    if n.get("role") == "verified":
        t["verified"] += 1
    elif n.get("role") == "canceled":
        t["canceled"] += 1
    elif n.get("permanently_blocked"):
        t["permanently_blocked"] += 1


# ---------------------------------------------------------------- main ---------

def parse_ids(val: str) -> list:
    return [x for x in (val or "").split(",") if x]


def main() -> None:
    ap = argparse.ArgumentParser(prog="derive", add_help=True)
    ap.add_argument("--state", required=True,
                    help="durable graph cache path (read+write; absent on first run)")
    ap.add_argument("--input", required=True,
                    help="adapter output (normalized sync or delta); '-' for stdin")
    ap.add_argument("--doc", default="-",
                    help="write the project-graph document here ('-' = stdout)")
    ap.add_argument("--exclude", default="",
                    help="comma-separated ids to keep out of scheduling sections")
    ap.add_argument("--top", default="",
                    help="comma-separated ids to force to the head of `available`")
    args = ap.parse_args()

    incoming = json.load(sys.stdin) if args.input == "-" else load_json(args.input)
    if incoming is None:
        die(f"no input at {args.input}")
    if incoming.get("schema") != SCHEMA_GRAPH:
        die(f"input schema must be {SCHEMA_GRAPH!r}, got {incoming.get('schema')!r}")

    cache = load_json(args.state) or empty_graph()
    cache = merge(cache, incoming)
    doc = compute(cache, set(parse_ids(args.exclude)), parse_ids(args.top))

    atomic_write(args.state, cache)      # durable graph (guarded milestone flags)
    if args.doc == "-":
        json.dump(doc, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:
        atomic_write(args.doc, doc)


if __name__ == "__main__":
    main()
