#!/usr/bin/env node
// graph — the deterministic half of the §2.6 producer.
//
//   graph merge  --cache <f> --delta <f>            merge a normalized fetch into the cache
//   graph derive --cache <f> [--exclude a,b] [--priority a,b]
//                                                   emit the project-graph document
//
// `merge` is a mechanical upsert (no graph reasoning). `derive` does all the
// reasoning the orchestrator is forbidden to do itself: effective-blocking,
// milestone gating, ranking, cycle detection, counts.
//
// Shapes: ../reference.md.

import {readFileSync, writeFileSync, renameSync, existsSync} from 'node:fs';

const TERMINAL = new Set(['verified', 'canceled']);
const PARKED = new Set(['paused', 'awaiting-external']);
const DEFAULT_PRIORITY = 100;

const die = (msg) => {
  console.error(`graph: ${msg}`);
  process.exit(2);
};

const argv = process.argv.slice(2);
const cmd = argv.shift();
const flag = (name) => {
  const i = argv.indexOf(`--${name}`);
  if (i === -1) return undefined;
  const value = argv[i + 1];
  // A missing value silently swallowing the next flag is how a typo turns into
  // a wrong graph, so reject it rather than guess.
  if (value === undefined || value.startsWith('--')) die(`--${name} needs a value`);
  return value;
};

const readJson = (path) => JSON.parse(readFileSync(path, 'utf8'));
const writeAtomic = (path, value) => {
  const tmp = `${path}.${process.pid}.tmp`;
  writeFileSync(tmp, `${JSON.stringify(value, null, 2)}\n`);
  renameSync(tmp, path);
};

const EMPTY = {cursor: null, projects: [], milestones: [], nodes: [], edges: []};
const edgeKey = (e) => `${e.blocker}>${e.blocked}`;

function merge(cachePath, deltaPath) {
  const delta = readJson(deltaPath);
  const cache =
    delta.full || !existsSync(cachePath) ? structuredClone(EMPTY) : readJson(cachePath);

  const deletedNodes = new Set();
  for (const collection of ['projects', 'milestones', 'nodes']) {
    const by = new Map((cache[collection] ?? []).map((x) => [x.id, x]));
    for (const item of delta[collection] ?? []) {
      if (item.removed) {
        by.delete(item.id);
        if (collection === 'nodes') deletedNodes.add(item.id);
      } else by.set(item.id, {...by.get(item.id), ...item});
    }
    cache[collection] = [...by.values()];
  }

  // A delta that restates a node's edges lists that node in `edges_for`; every
  // cached edge touching it is dropped before the delta's edges are applied, so
  // a deleted dependency does not survive as a stale edge.
  const restated = new Set(delta.edges_for ?? []);
  const edges = new Map(
    (cache.edges ?? [])
      .filter(
        (e) =>
          !restated.has(e.blocker) &&
          !restated.has(e.blocked) &&
          !deletedNodes.has(e.blocker) &&
          !deletedNodes.has(e.blocked),
      )
      .map((e) => [edgeKey(e), e]),
  );
  for (const e of delta.edges ?? []) {
    if (e.removed) edges.delete(edgeKey(e));
    else edges.set(edgeKey(e), {blocker: e.blocker, blocked: e.blocked});
  }
  // An edge naming an unknown node is kept, not pruned: it means the blocker is
  // outside the synced set, and dropping it would report blocked work as ready.
  // `derive` blocks the dependent and raises an anomaly.
  cache.edges = [...edges.values()];

  if (delta.cursor) cache.cursor = delta.cursor;
  writeAtomic(cachePath, cache);
  console.log(cachePath);
}

function derive(cachePath, excluded, prioritized) {
  const g = readJson(cachePath);
  const nodes = new Map(g.nodes.map((n) => [n.id, n]));
  const blockers = new Map([...nodes.keys()].map((id) => [id, []]));
  const dependents = new Map([...nodes.keys()].map((id) => [id, []]));
  const unknownBlockers = new Map(); // blocked id -> [unknown blocker ids]
  for (const e of g.edges) {
    if (!nodes.has(e.blocked)) continue; // the dependent is gone; nothing to schedule
    if (!nodes.has(e.blocker)) {
      unknownBlockers.set(e.blocked, [...(unknownBlockers.get(e.blocked) ?? []), e.blocker]);
      continue;
    }
    blockers.get(e.blocked).push(e.blocker);
    dependents.get(e.blocker).push(e.blocked);
  }

  const cycles = findCycles([...nodes.keys()], dependents);
  const inCycle = new Set(cycles.flat());

  const ancestorsOf = memo((id, recur) => {
    const seen = new Set();
    for (const b of blockers.get(id) ?? []) {
      if (seen.has(b)) continue;
      seen.add(b);
      if (!inCycle.has(b)) for (const a of recur(b)) seen.add(a);
    }
    return seen;
  });
  const descendantsOf = memo((id, recur) => {
    const seen = new Set();
    for (const d of dependents.get(id) ?? []) {
      if (seen.has(d)) continue;
      seen.add(d);
      if (!inCycle.has(d)) for (const x of recur(d)) seen.add(x);
    }
    return seen;
  });

  const terminal = (n) => TERMINAL.has(n.role);
  const parked = (n) => PARKED.has(n.role);
  // `dead` is the producer's classification: a ticket that terminated without
  // `verified` and will not progress. A *canceled* ancestor is not dead — §2.3
  // cancellation unblocks its dependents.
  const dead = (n) => Boolean(n.dead);
  // Waiting on a human: the explicit tracker signal, a human-only work item, or
  // a coordinator's worker-discovered park. `paused` (stopped for other
  // priorities) is not a human handoff.
  const humanBlocked = (n) =>
    !terminal(n) &&
    (Boolean(n.human_interactive) ||
      n.target_kind === 'human-only' ||
      n.role === 'awaiting-external');

  const anomalies = [
    ...cycles.map((c) => ({kind: 'cycle', nodes: c})),
    ...[...unknownBlockers].map(([id, missing]) => ({
      kind: 'unknown-blocker',
      node: id,
      blockers: missing,
    })),
  ];

  // A milestone is ready for review when every ticket in it is terminal and no
  // unresolved ticket is an ancestor of one (§2.3 Ready for review).
  const milestones = g.milestones.map((m) => {
    const members = g.nodes.filter((n) => n.milestone === m.id);
    const ready =
      members.length > 0 &&
      members.every(
        (n) => terminal(n) && [...ancestorsOf(n.id)].every((a) => terminal(nodes.get(a))),
      );
    return {...m, members: members.map((n) => n.id), ready_for_review: ready};
  });
  const milestoneById = new Map(milestones.map((m) => [m.id, m]));

  // §2.6 expresses the milestone-review gate as effective-blocking: a ticket in
  // milestone M is blocked while any earlier milestone of its project is not
  // both ready-for-review and review-recorded. An empty milestone gates nothing
  // — it has no review to run, so gating on it would deadlock the project.
  const gateOf = (n) => {
    const m = milestoneById.get(n.milestone);
    if (!m) return null;
    const open = milestones
      .filter(
        (p) =>
          p.project === m.project &&
          p.order < m.order &&
          p.members.length > 0 &&
          !(p.ready_for_review && p.review_recorded),
      )
      .sort((a, b) => a.order - b.order);
    return open.length > 0 ? open[0].id : null;
  };

  for (const n of g.nodes) {
    if (n.milestone && !milestoneById.has(n.milestone))
      anomalies.push({kind: 'unknown-milestone', node: n.id, milestone: n.milestone});
  }

  const tagged = g.nodes.map((n) => {
    const ancestors = [...ancestorsOf(n.id)].map((a) => nodes.get(a));
    const gate = gateOf(n);
    return {
      ...n,
      blocked_by: blockers.get(n.id) ?? [],
      effective_blocked:
        ancestors.some((a) => !terminal(a)) || Boolean(gate) || unknownBlockers.has(n.id),
      milestone_gate: gate,
      permanently_blocked: dead(n) || ancestors.some(dead),
      human_blocked: humanBlocked(n),
      unlocks: descendantsOf(n.id).size,
    };
  });

  const excludedSet = new Set(excluded);
  const available = tagged
    .filter(
      (n) =>
        !terminal(n) &&
        !n.permanently_blocked &&
        !n.human_blocked &&
        !n.effective_blocked &&
        !parked(n) &&
        !inCycle.has(n.id) &&
        n.group !== 'backlog' &&
        !excludedSet.has(n.id),
    )
    .sort(rankBy(prioritized, milestoneById))
    .map((n) => n.id);

  const workable = (n) => !terminal(n) && !n.permanently_blocked;
  const blocked = tagged.filter((n) => workable(n) && n.effective_blocked && !n.human_blocked);
  const human = tagged.filter((n) => workable(n) && n.human_blocked);
  const tally = (members) => ({
    total: members.length,
    verified: members.filter((n) => n.role === 'verified').length,
    canceled: members.filter((n) => n.role === 'canceled').length,
    permanently_blocked: members.filter((n) => n.permanently_blocked).length,
    remaining: members.filter(workable).length,
    terminal: members.every((n) => !workable(n)),
  });

  const scheduled = new Set([
    ...available,
    ...blocked.map((n) => n.id),
    ...human.map((n) => n.id),
  ]);

  return {
    cursor: g.cursor ?? null,
    projects: g.projects.map((p) => ({
      ...p,
      counts: tally(tagged.filter((n) => n.project === p.id)),
    })),
    milestones: milestones.map((m) => ({
      id: m.id,
      project: m.project,
      name: m.name,
      order: m.order,
      ready_for_review: m.ready_for_review,
      review_recorded: Boolean(m.review_recorded),
      counts: tally(tagged.filter((n) => n.milestone === m.id)),
    })),
    nodes: tagged,
    available,
    blocked: blocked.map((n) => n.id),
    human_blocked: human.map((n) => n.id),
    permanently_blocked: tagged.filter((n) => n.permanently_blocked).map((n) => n.id),
    // Workable but in no scheduling section: `backlog`, `paused`, or held out of
    // a cycle. Nothing will dispatch them and they keep `remaining` above zero,
    // so the orchestrator must name them when it reports an idle tick.
    stalled: tagged.filter((n) => workable(n) && !scheduled.has(n.id)).map((n) => n.id),
    counts: tally(tagged),
    anomalies: [
      ...anomalies,
      ...crossProjectCycles(g, nodes).map((c) => ({kind: 'cross-project-cycle', projects: c})),
    ],
  };
}

// Rank: injected work first, then earliest milestone, then whatever unlocks the
// most, then id (so the order is total and stable). `-Infinity` keeps an
// injected ticket ahead of a node whose own `priority` is 0.
const rankBy = (prioritized, milestoneById) => (a, b) => {
  const pri = (n) => (prioritized.includes(n.id) ? -Infinity : (n.priority ?? DEFAULT_PRIORITY));
  const ord = (n) => milestoneById.get(n.milestone)?.order ?? Number.MAX_SAFE_INTEGER;
  return (
    pri(a) - pri(b) ||
    ord(a) - ord(b) ||
    b.unlocks - a.unlocks ||
    String(a.id).localeCompare(String(b.id))
  );
};

function memo(fn) {
  const cache = new Map();
  const recur = (id) => {
    if (cache.has(id)) return cache.get(id);
    cache.set(id, new Set()); // cycle guard: an in-progress walk sees itself as empty
    const value = fn(id, recur);
    cache.set(id, value);
    return value;
  };
  return recur;
}

// Iterative Tarjan over `ids` with `next` as the successor map. Every strongly
// connected component of size > 1 (or a self-edge) is a cycle.
function findCycles(ids, next) {
  const index = new Map();
  const low = new Map();
  const onStack = new Set();
  const stack = [];
  const cycles = [];
  let counter = 0;

  for (const root of ids) {
    if (index.has(root)) continue;
    const work = [[root, 0]];
    while (work.length > 0) {
      const frame = work[work.length - 1];
      const [v, i] = frame;
      if (i === 0) {
        index.set(v, counter);
        low.set(v, counter);
        counter += 1;
        stack.push(v);
        onStack.add(v);
      }
      const successors = next.get(v) ?? [];
      if (i < successors.length) {
        frame[1] += 1;
        const w = successors[i];
        if (!index.has(w)) work.push([w, 0]);
        else if (onStack.has(w)) low.set(v, Math.min(low.get(v), index.get(w)));
        continue;
      }
      work.pop();
      if (work.length > 0) {
        const parent = work[work.length - 1][0];
        low.set(parent, Math.min(low.get(parent), low.get(v)));
      }
      if (low.get(v) === index.get(v)) {
        const component = [];
        let w;
        do {
          w = stack.pop();
          onStack.delete(w);
          component.push(w);
        } while (w !== v);
        const selfEdge = (next.get(v) ?? []).includes(v);
        if (component.length > 1 || selfEdge) cycles.push(component.sort());
      }
    }
  }
  return cycles;
}

// Projects that depend on each other cannot be scheduled in any order. §2.3
// calls these cross-project reverse edges; report them, never work around them.
function crossProjectCycles(g, nodes) {
  const next = new Map(g.projects.map((p) => [p.id, []]));
  for (const e of g.edges) {
    const from = nodes.get(e.blocker)?.project;
    const to = nodes.get(e.blocked)?.project;
    if (from && to && from !== to && next.has(from) && !next.get(from).includes(to))
      next.get(from).push(to);
  }
  return findCycles([...next.keys()], next);
}

const cache = flag('cache') ?? die('--cache required');
const list = (name) => (flag(name) ?? '').split(',').filter(Boolean);

if (cmd === 'merge') merge(cache, flag('delta') ?? die('--delta required'));
else if (cmd === 'derive')
  console.log(JSON.stringify(derive(cache, list('exclude'), list('priority')), null, 2));
else die('usage: graph {merge|derive} --cache <f> [...]');
