#!/usr/bin/env bash
# Thin shim kept at the path the deliver skill invokes (`scripts/pr-status`).
# Delegates to the dispatch CLI launcher, which execs the per-platform binary
# (or falls back to pr-status.legacy.bash when no binary is committed yet).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugin_root="$(cd "$here/../../.." && pwd)"
exec "$plugin_root/bin/dispatch" pr-status "$@"
