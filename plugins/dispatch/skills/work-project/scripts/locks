#!/usr/bin/env bash
# locks — §2.6 liveness locks for dispatched units.
#
# One lock file per dispatched unit, keyed by ticket id (coordinator with a
# ticket), forge PR identity (bare-PR coordinator), or milestone id (milestone
# review agent). Heartbeated on a fixed interval; a dispatched unit is presumed
# dead when its lock age exceeds the staleness threshold, and the orchestrator
# re-dispatches. Locks are advisory bookkeeping, distinct from compute `slots`.
#
# A key is any string; the orchestrator slugs unsafe characters (e.g. a PR key
# "<repo>#<n>" -> "<repo>__<n>") before passing it. Lock dir: --dir <path> or env
# DISPATCH_LOCK_DIR.
#
# Usage:
#   locks write <key> <agent_id> <kind>   create/refresh a lock (kind: ticket|pr|milestone)
#   locks heartbeat <key> <agent_id>      refresh; exit 4 if the lock is held by another id
#   locks alive <key> <stale_sec>         exit 0 (+print owner) if a fresh lock exists, else 1
#   locks owner <key>                     print the lock's agent_id (empty if none)
#   locks clear <key>                     remove the lock
#   locks sweep <stale_sec>               remove every stale lock; print "<key>\t<agent_id>" cleared
#
# Requires: jq. Exit: 2 usage, 1 not-alive, 4 owner mismatch.
set -euo pipefail

DIR="${DISPATCH_LOCK_DIR:-}"
CMD="${1:-}"; shift || true
if [[ "${CMD}" == "--dir" ]]; then DIR="${1:-}"; shift; CMD="${1:-}"; shift || true; fi
[[ -n "$DIR" ]] || { echo "locks: set DISPATCH_LOCK_DIR or pass --dir <path>" >&2; exit 2; }
command -v jq >/dev/null || { echo "locks: jq required" >&2; exit 2; }

now() { date +%s; }
path_for() { printf '%s/%s.json' "$DIR" "$1"; }

write_atomic() {  # write_atomic <file> <json>
  local tmp; tmp="$(mktemp "$1.XXXXXX")"
  printf '%s\n' "$2" >"$tmp"; mv -f "$tmp" "$1"
}

do_write() {
  local key="$1" agent="$2" kind="$3" f; f="$(path_for "$key")"
  mkdir -p "$DIR"
  write_atomic "$f" "$(jq -cn --arg k "$key" --arg a "$agent" --arg kind "$kind" --argjson t "$(now)" \
    '{key:$k, agent_id:$a, kind:$kind, heartbeat:$t}')"
}

do_heartbeat() {
  # Refresh an existing lock this agent owns. A missing lock (reclaimed by a
  # sweep) is NOT silently resurrected: exit 4 so the caller learns it was
  # presumed dead and must re-establish via `write` if still alive.
  local key="$1" agent="$2" f owner; f="$(path_for "$key")"
  [[ -f "$f" ]] || exit 4
  owner="$(jq -r '.agent_id // empty' "$f")"
  [[ -z "$owner" || "$owner" == "$agent" ]] || exit 4
  write_atomic "$f" "$(jq -c --argjson t "$(now)" '.heartbeat=$t' "$f")"
}

do_alive() {
  local key="$1" stale="$2" f owner hb; f="$(path_for "$key")"
  [[ -f "$f" ]] || return 1
  owner="$(jq -r '.agent_id // empty' "$f")"; hb="$(jq -r '.heartbeat // 0' "$f")"
  if (( $(now) - hb <= stale )); then echo "$owner"; return 0; fi
  return 1
}

do_owner() { local f; f="$(path_for "$1")"; [[ -f "$f" ]] && jq -r '.agent_id // empty' "$f" || true; }

do_clear() { rm -f "$(path_for "$1")"; }

do_sweep() {
  local stale="$1" cutoff f owner hb; cutoff=$(( $(now) - stale ))
  shopt -s nullglob
  for f in "$DIR"/*.json; do
    hb="$(jq -r '.heartbeat // 0' "$f")"
    if (( hb < cutoff )); then
      owner="$(jq -r '.agent_id // empty' "$f")"
      printf '%s\t%s\n' "$(jq -r '.key' "$f")" "$owner"
      rm -f "$f"
    fi
  done
}

case "$CMD" in
  write)     do_write "${1:?key}" "${2:?agent_id}" "${3:?kind}" ;;
  heartbeat) do_heartbeat "${1:?key}" "${2:?agent_id}" ;;
  alive)     do_alive "${1:?key}" "${2:?stale_sec}" ;;
  owner)     do_owner "${1:?key}" ;;
  clear)     do_clear "${1:?key}" ;;
  sweep)     do_sweep "${1:?stale_sec}" ;;
  *) echo "locks: unknown command '${CMD}' (write|heartbeat|alive|owner|clear|sweep)" >&2; exit 2 ;;
esac
